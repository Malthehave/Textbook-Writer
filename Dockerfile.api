FROM python:3.12-slim

WORKDIR /app

# Pinned: Typst makes breaking syntax changes between minors, and the .typ
# templates plus md2typst output are version-sensitive. Keep in step with the
# host version in the README's "Without Docker" path.
ARG TYPST_VERSION=0.15.1

# poppler-utils supplies pdftoppm for publishing/pdf.py page rendering.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl ca-certificates xz-utils poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

# Typst is not packaged for Debian; use the official static musl build.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        arm64) target='aarch64-unknown-linux-musl' ;; \
        amd64) target='x86_64-unknown-linux-musl' ;; \
        *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-${target}.tar.xz" \
        | tar -xJ -C /tmp; \
    mv "/tmp/typst-${target}/typst" /usr/local/bin/typst; \
    rm -rf "/tmp/typst-${target}"; \
    typst --version; \
    pdftoppm -v

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY AGENTS.md ./

RUN uv sync --frozen --no-dev

ENV TEXTBOOK_API_ROOT=/app
ENV TEXTBOOK_SESSIONS_DB=/app/output/ui-sessions.sqlite
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "textbook_writer.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
