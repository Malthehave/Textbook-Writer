FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY AGENTS.md ./

RUN uv sync --frozen --no-dev

ENV TEXTBOOK_API_ROOT=/app
ENV TEXTBOOK_BOOKS_ROOT=/app/output/books
ENV TEXTBOOK_SESSIONS_DB=/app/output/ui-sessions.sqlite
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "textbook_writer.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
